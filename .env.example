# PostgreSQL (kontener db)
DB_USER=trainer
DB_PASSWORD=change-me
DB_NAME=trainer_crm

# backend uruchamiany lokalnie (poza Dockerem) - baza wystawiona na porcie 5433
DATABASE_URL=postgres://trainer:change-me@localhost:5433/trainer_crm
TEST_DATABASE_URL=postgres://trainer:change-me@localhost:5433/trainer_crm_test
PORT=3000

# JWT - minimum 32 znaki, wygeneruj: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# konto administratora tworzone przez seed
ADMIN_EMAIL=admin@trainer-crm.local
ADMIN_PASSWORD=change-me

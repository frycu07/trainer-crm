{
  "name": "trainer-crm-backend",
  "version": "1.0.0",
  "description": "Trainer CRM - backend REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "NODE_ENV=test node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test": "npm run test:unit && npm run test:integration"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
